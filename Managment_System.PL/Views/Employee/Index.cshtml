@model IEnumerable<Employee>

@{
    ViewBag.Title = "Employees";
    Layout = "_Layout";
}

<h1>Employees</h1>

<br/>
<br/>
<a class="btn btn-primary" asp-action="Create">Add New Employee</a>
<br/>
<br/>

<div class="row justify-content-center align-items-center mt-5">
    <form asp-action="index" class="row col-8">
        <div class="col-8">
            <input type="text" class="form-control" name="searchInput" placeholder="Search By Name"/>
        </div>
        <div class="row col-4">
            <input type="submit" value="Search" class="btn btn-primary"/>
        </div>
    </form>
</div>

<br/>
<br/>

<table class="table table-bordered table-striped table-hover text-center fs-4">
    <thead>
    <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        @*<th scope="col">Phone</th>
        <th scope="col">Age</th>
        <th scope="col">Gender</th>
        <th scope="col">Is Active</th>
        <th scope="col">Hiring Date</th>
        <th scope="col">Salary</th>*@
        <th scope="col">Employee Type</th>
        <th scope="col">Details</th>
        <th scope="col">Edit</th>
        <th scope="col">Delete</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var employee in Model)
    {
        <tr>
            <td>@employee.Name</td>
            <td>@employee.Email</td>
            @*<td>@employee.PhoneNumber</td>
            <td>@employee.Age</td>
            <td>@employee.Gender</td>
            <td>@employee.IsActive</td>
            <td>@employee.HiringDate.ToString("dd-MM-yyyy")</td>
            <td>@employee.Salary</td>*@
            <td>@employee.EmployeeType</td>
            <partial name="_ButtonsPartial" model="@employee.Id" />
        </tr>
    }
    </tbody>
</table>
