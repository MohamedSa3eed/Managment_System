@model Department

@{
    ViewBag.Title = "Department Details";
    Layout = "_Layout";
}

<h1>Department Details</h1>
<div class="form-group">
    <label asp-for="Code" class="col-form-label"></label>
    <input asp-for="Code" class="form-control" readonly />
</div>
<div class="form-group">
    <label asp-for="Name" class="col-form-label"></label>
    <input asp-for="Name" class="form-control" readonly />
</div>
<div class="form-group">
    <label asp-for="StartDate" class="col-form-label"></label>
    <input asp-for="StartDate" class="form-control" readonly />
</div>
<br/>
<br/>
<div class="form-group">
    <input type="button" value="Back to List" class="btn btn-secondary" onclick="location.href='@Url.Action("Index", "Department")'" />
</div>