@model Department

@{
    ViewBag.Title = "Edit Department";
    Layout = "_Layout";
}

<h1>Edit Department</h1>
<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="Code" class="col-form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name" class="col-form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StartDate" class="col-form-label"></label>
        <input asp-for="StartDate" class="form-control" />
    </div>
    <br/>
    <br/>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <input type="button" value="Cancel" class="btn btn-secondary" onclick="location.href='@Url.Action("Index", "Department")'" />
    </div>
</form>
