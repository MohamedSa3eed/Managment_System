@model Managment_System.DAL.Models.Department

@{
    ViewBag.Title = "Delete Department";
    Layout = "_Layout";
}

<h1>Delete Department</h1>
<hr />

<div class="alert alert-danger" role="alert">
    <strong>Warning!</strong> Are you sure you want to delete this department? This action cannot be undone.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.HiddenFor(m => m.Id)
    @Html.AntiForgeryToken()
    
    <div class="btn-group" role="group">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
